{
	"$schema": "https://turbo.build/schema.json",

	"globalEnv": ["NODE_ENV"],

	"tasks": {
		"build": {
			"outputs": ["Target/**"]
		},

		"Build": {
			"outputs": ["Target/**"]
		},

		"check": {
			"outputs": []
		},

		"tool": {
			"cache": false,

			"dependsOn": ["Build"]
		}
	},

	"ui": "stream"
}
