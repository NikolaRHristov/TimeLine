# Astro's dev + content-layer cache. Regenerated by `astro sync` / `astro dev`.
# It stores absolute `file://` URLs, so committing it leaks the local machine's
# paths into a public repository.
.astro/

# Local identifier map: list ids, handles, anything machine-specific.
Maintain/Configuration/Local/

# Shadow store: everything scraped. Never published, never committed.
Maintain/Storage/

# Compiled tool layer: generated by `pnpm tool`, never hand-edited.
Maintain/Target/

# Turbo's run cache.
.turbo/

node_modules/
