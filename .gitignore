# Astro's dev + content-layer cache. Regenerated by `astro sync` / `astro dev`.
# It stores absolute `file://` URLs, so committing it leaks the local machine's
# paths into a public repository.
.astro/

# Local identifier map: list ids, handles, anything machine-specific.
Maintain/Configuration/Local/

# Shadow store: everything scraped. Never published, never committed.
Maintain/Storage/

# esbuild options for the tool layer. `Configuration/ESBuild.ts` is the source;
# this is its emit, which `@playform/build` imports (it rewrites `.ts` to `.js`).
Maintain/Configuration/ESBuild.js

# Compiled tool layer: generated by `pnpm Build`, never hand-edited.
Maintain/Target/

# Compiled site: `astro build` writes it and regenerates it on the next run.
# Committed once by accident, it publishes every post the archive held.
# Root-anchored: an unanchored `Target/` also matches the real source directory
# `Maintain/Source/Browser/Target/`, silently ignoring new files added there.
/Target/

# Turbo's run cache.
.turbo/

node_modules/

# Local secrets: Firebase token, any API key. The global ignore also covers
# `.env`, but a token in this repo deserves a rule that travels with the repo.
.env
.env.*
!.env.example

# Firebase project pin. It names one project, so it is per-clone, not shared.
.firebaserc
firebase-debug.log
.firebase/logs/vsce-debug.log

!AGENTS.md
.hermes-tmp-measure.mjs
