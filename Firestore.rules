rules_version = '2';

// Owner-scoped by default, closed otherwise.
//
// The site is served from Cloudflare Pages; Firebase is the backend only
// (Auth, Firestore, Storage). Every write arrives from a signed-in client, so
// `request.auth.uid` is the only identity worth trusting here - never a field
// in the document, which the client controls.
service cloud.firestore {
  match /databases/{database}/documents {
    // A user's own subtree: read and write only by that user.
    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Curated, publicly readable content: anyone may read, only the owner writes.
    match /public/{document=**} {
      allow read: if true;
      allow write: if request.auth != null
        && request.auth.token.get('owner', false) == true;
    }

    // Everything else is closed. A new collection needs a rule, deliberately.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
