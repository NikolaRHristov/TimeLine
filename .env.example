# Template for `.env`. Copy to `.env` and fill in - `.env` is gitignored.
#
# Get the values with:
#   firebase apps:sdkconfig web --project <project-id>
#
# A Firebase web apiKey is a public identifier, not a credential. The CLI
# refresh token is the secret, and it belongs in the configstore (written by
# `firebase login`), never here.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=

# The canonical origin the site answers on. Used for the `<link rel="canonical">`
# tag, the Open Graph URL and the sitemap. Unset, the build falls back to the
# reserved example domain `https://timeline.example`, which keeps a fresh clone
# building valid absolute URLs instead of `undefined`.
SITE_URL=

# The repository the shell's "Source" link points at. Unset, the link is not
# rendered at all - a missing link is better than a dead one.
REPOSITORY_URL=
