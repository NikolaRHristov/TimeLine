# Template for `.env`. Copy to `.env` and fill in - `.env` is gitignored.
#
# Get the values with:
#   firebase apps:sdkconfig web --project <project-id>
#
# A Firebase web apiKey is a public identifier, not a credential. The CLI
# refresh token is the secret, and it belongs in the configstore (written by
# `firebase login`), never here.

FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
