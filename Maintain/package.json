{
	"name": "@nikolarhristov/timeline-maintain",
	"version": "0.0.1",
	"private": true,
	"description": "Local tool layer: a dependency-free CDP client the site's content is scraped with.",
	"type": "module",
	"bin": {
		"maintain": "Target/Index.js"
	},
	"scripts": {
		"Build": "pnpm run Prepare && Build 'Source/**/*.ts' --ESBuild Configuration/ESBuild.ts",
		"Prepare": "esbuild Configuration/ESBuild.ts --format=esm --platform=node --target=esnext --outfile=Configuration/ESBuild.js",
		"Watch": "pnpm run Prepare && Build 'Source/**/*.ts' --Watch --ESBuild Configuration/ESBuild.ts",
		"check": "tsc --noEmit -p tsconfig.json",
		"test": "node --test Target/Test/*.test.js",
		"tool": "node Target/Index.js"
	},
	"devDependencies": {
		"@playform/build": "0.3.5",
		"@types/node": "26.6.6",
		"esbuild": "0.28.2",
		"tsc-alias": "1.9.9",
		"typescript": "7.0.2"
	}
}
