{
	"name": "timeline-bookmarks",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@11.18.0",
	"description": "A bookmark showcase you own: your X bookmarks, your lists, a static site.",
	"keywords": [
		"astro",
		"bookmarks",
		"cdp",
		"tailwindcss"
	],
	"license": "SEE LICENSE IN LICENSE",
	"author": {
		"name": "Timeline contributors"
	},
	"scripts": {
		"build": "astro build",
		"Build": "pnpm --filter @nikolarhristov/timeline-maintain run Build",
		"tool": "pnpm --filter @nikolarhristov/timeline-maintain run tool",
		"maintain": "node Maintain/Target/Index.js",
		"Run": "astro dev --host",
		"prepublishOnly": "pnpm run build"
	},
	"dependencies": {
		"@astrojs/sitemap": "3.7.4",
		"@playform/build": "0.3.4",
		"@playform/compress": "0.2.5",
		"@playform/inline": "0.1.4",
		"@tailwindcss/aspect-ratio": "0.4.2",
		"@tailwindcss/forms": "0.5.11",
		"@tailwindcss/typography": "0.5.20",
		"astro": "7.4.2",
		"astro-capo": "0.0.1",
		"astrojs-service-worker": "2.0.3",
		"autoprefixer": "10.6.2",
		"cssnano": "9.9.0",
		"cssnano-preset-advanced": "10.0.0",
		"dotenv": "18.0.9",
		"firebase": "13.1.0",
		"postcss": "8.5.32",
		"postcss-combine-duplicated-selectors": "11.0.0",
		"postcss-combine-media-query": "2.1.0",
		"postcss-import": "17.0.1",
		"postcss-reporter": "7.1.0",
		"postcss-url": "10.1.4",
		"tailwindcss": "3.4.19",
		"typescript": "7.0.2",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@astrojs/ts-plugin": "1.10.12",
		"turbo": "2.11.10"
	},
	"publishConfig": {
		"access": "restricted",
		"provenance": true
	}
}
