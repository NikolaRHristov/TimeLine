---
/**
 * The shell every page renders inside.
 *
 * Structure taken from the sibling site this repository borrows its shell from:
 * a skip link, a sticky header holding the brand and the primary navigation,
 * the content column, and a footer carrying the sitemap and the licence. The
 * sibling is not named here - `Documentation/Reference/URL-And-Shell.md`
 * explains why a public tree never names a private origin, and it calls the
 * siblings Site A … Site D. Two things are deliberately different.
 *
 * - No theme switch. The pages style themselves with Tailwind utilities pinned
 *   to light values, so a switch that themed only the chrome would produce a
 *   dark header over a white article. `Stylesheet/Global.css` holds the tokens
 *   a real theme would use; converting the pages is the precondition.
 * - No Google Fonts request. The site is a static archive read offline from a
 *   service worker, and a third-party font fetch is the one thing on the page
 *   that cannot be served from cache - so the system stack is used instead.
 *
 * Every internal link comes from `@Library/Link.ts`, which derives it from the
 * route map. No path is spelled in this file, so a route rename cannot leave a
 * dead link behind.
 */
import "@Stylesheet/Base.css";
import { Content, Repository, Site } from "@Library/Content.ts";
import { IsCurrent, Primary, Route, Sitemap } from "@Library/Link.ts";
import { Head } from "astro-capo";
import { ClientRouter } from "astro:transitions";

interface Props {
	Title?: string;
	Description?: string;
}

const { Title = Content.Title, Description = Content.Description } = Astro.props;

const Path = Astro.url.pathname;
const Canonical = new URL(Path, Site).href;
const Full = Title === Content.Title ? Title : `${Title} - ${Content.Short}`;
const Year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" dir="ltr">
	<Head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{Full}</title>
		<meta name="description" content={Description} />
		<link rel="canonical" href={Canonical} />
		<meta name="theme-color" content="#ffffff" />
		<meta name="format-detection" content="telephone=no" />
		<meta name="twitter:dnt" content="on" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={Content.Short} />
		<meta property="og:title" content={Full} />
		<meta property="og:description" content={Description} />
		<meta property="og:url" content={Canonical} />

		<link rel="manifest" href="/Manifest.json" crossorigin="use-credentials" />

		<style is:global>
			@import "@Stylesheet/Global.css";
			@import "@Stylesheet/Layout/Shell.css";
			@import "@Stylesheet/Layout/Page.css";
		</style>

		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@type": "WebSite",
				name: Content.Title,
				url: Site,
				description: Content.Description,
			})}
		/>
		<slot name="Head" />

		<ClientRouter />
	</Head>
	<body>
		<a class="skip" href="#main">
			Skip to content
		</a>

		<header class="shell-header">
			<div class="page shell-header__inner">
				<a class="shell-brand" href={Route.Home}>
					<span class="shell-brand__mark" aria-hidden="true">
						TL
					</span>
					<span class="shell-brand__name">{Content.Short}</span>
				</a>

				<nav class="shell-nav" aria-label="Primary">
					<ul>
						{Primary.map((Entry) => (
							<li>
								<a
									href={Entry.Href}
									aria-current={IsCurrent(Path, Entry.Href) ? "page" : undefined}>
									{Entry.Label}
								</a>
							</li>
						))}
					</ul>
				</nav>

				{Repository !== "" && (
					<a class="shell-repository" href={Repository} rel="noopener noreferrer">
						Source
					</a>
				)}
			</div>
		</header>

		<main id="main" class="page shell-main">
			<slot />
		</main>

		<footer class="shell-footer">
			<div class="page shell-footer__inner">
				<div class="shell-footer__brand">
					<p class="shell-footer__name">{Content.Title}</p>
					<p class="shell-footer__note">{Content.Description}</p>
				</div>

				<nav class="shell-sitemap" aria-label="Sitemap">
					<ul>
						{Sitemap.map((Entry) => (
							<li>
								<a href={Entry.Href}>{Entry.Label}</a>
							</li>
						))}
					</ul>
				</nav>

				<p class="shell-footer__licence">
					<span>{Content.Licence}</span>
					<span>{Year}</span>
				</p>
			</div>
		</footer>

		{import.meta.env.PROD && <script is:inline>
			// Registered here rather than by the integration, so the worker
			// exists in a production build and nowhere else - `astro dev`
			// serves a no-op worker that would otherwise clear and re-register
			// itself on every reload. The scope is the origin root, stated
			// rather than inferred from where the script happens to live.
			if ("serviceWorker" in navigator) {
				navigator.serviceWorker.register("/service-worker.js", { scope: "/" }).catch(() => {
					// A worker that fails to register is a cache miss, not a
					// broken page: the site is fully static and works without it.
				});
			}
		</script>}
	</body>
</html>
