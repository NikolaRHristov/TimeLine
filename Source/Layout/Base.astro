---
/**
 * The shell every page renders inside.
 *
 * Structure taken from the sibling site this repository borrows its shell from:
 * a skip link, a sticky header holding the brand and the primary navigation,
 * the content column, and a footer carrying the sitemap and the licence. The
 * sibling is not named here - `Documentation/Reference/URL-And-Shell.md`
 * explains why a public tree never names a private origin, and it calls the
 * siblings Site A ... Site D. Two things are deliberately different.
 *
 * - No theme switch. The shell is the instrument panel and the page is the
 *   paper: a dark frame around a light canvas, which is the split the
 *   composition draws rather than a half-applied theme. Every sheet reads a
 *   token from `Stylesheet/Global.css`, so the palette lives in one place and a
 *   second one would be a second block of values, not a second set of rules.
 * - No Google Fonts request. The site is a static archive read offline from a
 *   service worker, and a third-party font fetch is the one thing on the page
 *   that cannot be served from cache - so the system stack is used instead.
 *
 * Every internal link comes from `@Library/Link.ts`, which derives it from the
 * route map. No path is spelled in this file, so a route rename cannot leave a
 * dead link behind. Every word comes from `@Library/Content.ts`, which is baked
 * from `Content/**` at build time.
 */
import "@Stylesheet/Base.css";
import { Content, Repository, Site } from "@Library/Content.ts";
import { IsCurrent, Primary, Route, Sitemap } from "@Library/Link.ts";
import { Head } from "astro-capo";
import { ClientRouter } from "astro:transitions";

interface Props {
	Title?: string;
	Description?: string;
	/**
	 * Render the content column at full width.
	 *
	 * The shell's measure is right for prose - an article wants 48rem - and wrong
	 * for an application surface, which is laid out against the viewport. A page
	 * that mounts one opts in rather than overriding the shell's own rule, so the
	 * measure stays a single decision made in one place.
	 */
	Wide?: boolean;
	/**
	 * Render the surface on its own, with no header, footer or block padding.
	 *
	 * The workspace is the whole frame, not an article inside one: its own rail
	 * starts at the top-left of the viewport and the drawer's ground runs to the
	 * top edge, so a sticky header above it would push the composition down and
	 * break every proportion the design states in absolute pixels. A page that
	 * owns the screen asks for this; every other page keeps the shell.
	 */
	Bare?: boolean;
}

const {
	Title = Content.Brand.Title,
	Description = Content.Brand.Description,
	Wide = false,
	Bare = false,
} = Astro.props;

const Path = Astro.url.pathname;
const Canonical = new URL(Path, Site).href;
const Full = Title === Content.Brand.Title ? Title : `${Title} - ${Content.Brand.Short}`;
const Year = new Date().getFullYear();
---

<!doctype html>
<html lang="en" dir="ltr">
	<Head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1.0" />
		<title>{Full}</title>
		<!-- An empty data icon rather than a missing file: every browser asks for
		     /favicon.ico on its own, and a 404 for a file the page never
		     referenced is noise in the console of every route. A real mark goes
		     here once the brand has one. -->
		<link rel="icon" href="data:," />
		<meta name="description" content={Description} />
		<link rel="canonical" href={Canonical} />
		<meta name="theme-color" content="#1c1c1e" />
		<meta name="format-detection" content="telephone=no" />
		<meta name="twitter:dnt" content="on" />

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={Content.Brand.Short} />
		<meta property="og:title" content={Full} />
		<meta property="og:description" content={Description} />
		<meta property="og:url" content={Canonical} />

		<link rel="manifest" href="/Manifest.json" crossorigin="use-credentials" />

		<style is:global lang="scss">
			@use "../Stylesheet/Global.css" as *;
			@use "../Stylesheet/Layout/Shell.scss" as *;
			@use "../Stylesheet/Layout/Page.scss" as *;
		</style>

		<script
			type="application/ld+json"
			set:html={JSON.stringify({
				"@context": "https://schema.org",
				"@type": "WebSite",
				name: Content.Brand.Title,
				url: Site,
				description: Content.Brand.Description,
			})}
		/>
		<slot name="Head" />

		<ClientRouter />
	</Head>
	<body class:list={{ "shell-body--bare": Bare }}>
		<a class="skip" href="#main">
			{Content.Shell.Skip}
		</a>

		{!Bare && (
			<header class="shell-header">
				<div class="page shell-header__inner">
					<a class="shell-brand" href={Route.Home}>
						<span class="shell-brand__mark" aria-hidden="true">
							{Content.Shell.Mark}
						</span>
						<span class="shell-brand__name">{Content.Brand.Short}</span>
					</a>

					<nav class="shell-nav" aria-label={Content.Shell.Primary}>
						<ul>
							{Primary.map((Entry) => (
								<li>
									<a
										href={Entry.Href}
										aria-current={
											IsCurrent(Path, Entry.Href) ? "page" : undefined
										}>
										{Entry.Label}
									</a>
								</li>
							))}
						</ul>
					</nav>

					{Repository !== "" && (
						<a class="shell-repository" href={Repository} rel="noopener noreferrer">
							{Content.Shell.Repository}
						</a>
					)}
				</div>
			</header>
		)}

		<main
			id="main"
			class:list={["page", "shell-main", { "page--wide": Wide, "shell-main--bare": Bare }]}>
			<slot />
		</main>

		{!Bare && (
			<footer class="shell-footer">
				<div class="page shell-footer__inner">
					<div class="shell-footer__brand">
						<p class="shell-footer__name">{Content.Brand.Title}</p>
						<p class="shell-footer__note">{Content.Brand.Description}</p>
					</div>

					<nav class="shell-sitemap" aria-label={Content.Shell.Sitemap}>
						<ul>
							{Sitemap.map((Entry) => (
								<li>
									<a href={Entry.Href}>{Entry.Label}</a>
								</li>
							))}
						</ul>
					</nav>

					<p class="shell-footer__licence">
						<span>{Content.Brand.Licence}</span>
						<span>{Year}</span>
					</p>
				</div>
			</footer>
		)}

		{import.meta.env.PROD && <script is:inline>
			// Registered here rather than by the integration, so the worker
			// exists in a production build and nowhere else - `astro dev`
			// serves a no-op worker that would otherwise clear and re-register
			// itself on every reload. The scope is the origin root, stated
			// rather than inferred from where the script happens to live.
			if ("serviceWorker" in navigator) {
				navigator.serviceWorker.register("/service-worker.js", { scope: "/" }).catch(() => {
					// A worker that fails to register is a cache miss, not a
					// broken page: the site is fully static and works without it.
				});
			}
		</script>}
	</body>
</html>
