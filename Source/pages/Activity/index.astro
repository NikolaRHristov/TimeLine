---
/**
 * The event log, newest first.
 *
 * Events are files, so this page is a build-time read of the Event collection -
 * no client JavaScript, no feed to poll. The live view of the same directory is
 * `node Maintain/Index.ts event tail --follow`, which prints the files as they
 * land.
 */
import Base from "@Layout/Base.astro";
import { getCollection } from "astro:content";

const events = (await getCollection("Event")).sort((left, right) =>
	right.data.at.localeCompare(left.data.at),
);
const bookmarks = new Set((await getCollection("Bookmark")).map((entry) => entry.id));

const moment = (value: string): string => `${value.slice(0, 10)} ${value.slice(11, 19)}Z`;
const isPost = (subject: string): boolean => bookmarks.has(subject);
---

<Base Title="Activity" Description="What the bookmark pipeline did, newest first.">
	<main class="container mx-auto max-w-3xl px-6 py-10">
		<header class="mb-8">
			<h1 class="text-2xl font-semibold">Activity</h1>
			<p class="mt-1 text-sm text-neutral-600">
				{events.length} {events.length === 1 ? "event" : "events"}, newest first.
			</p>
		</header>

		<ol class="space-y-2">
			{events.map((entry) => (
				<li class="flex flex-wrap items-baseline gap-x-3 border-b border-neutral-100 pb-2 text-sm">
					<time
						class="w-40 shrink-0 font-mono text-xs text-neutral-500"
						datetime={entry.data.at}>
						{moment(entry.data.at)}
					</time>
					<span class="font-medium">{entry.data.kind}</span>
					<span class="text-neutral-600">
						{isPost(entry.data.subject) ? (
							<a
								class="underline decoration-neutral-300 underline-offset-2"
								href={`/Bookmark/${entry.data.subject}/`}>
								{entry.data.subject}
							</a>
						) : (
							entry.data.subject
						)}
					</span>
					{typeof entry.data.payload?.count === "number" && (
						<span class="text-xs text-neutral-500">
							{entry.data.payload.count} posts
						</span>
					)}
				</li>
			))}
		</ol>

		{events.length === 0 && (
			<p class="text-sm text-neutral-600">
				Nothing recorded yet. Events appear here once a post is published.
			</p>
		)}

		<footer class="mt-12 border-t border-neutral-200 pt-4 text-xs text-neutral-500">
			<a class="underline" href="/Bookmark/">
				Bookmarks
			</a>
		</footer>
	</main>
</Base>
