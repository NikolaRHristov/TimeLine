---
/**
 * Activity: what the log is, rather than the log.
 *
 * The route used to print the event collection newest first, each row a moment,
 * a kind and a subject. It was the pipeline's own record rendered as a page -
 * and on a clone that has not run the pipeline it was one note saying so.
 *
 * RFC-0053 makes it a showcase page: no collection is read, no row is drawn, no
 * timestamp is printed. The three sections say what a motion is, what a subject
 * lets a reader follow, and why the page and the tool layer can never disagree
 * about the archive's history. The rail is the workspace's drum reused as a
 * table of contents.
 *
 * The live view of the same directory is the tool layer's own `event tail
 * --follow`, which is where a reader who wants the log goes.
 */
import Board, { type Frame } from "@Component/Showcase/Board.astro";
import Base from "@Layout/Base.astro";
import { Content } from "@Library/Content.ts";
import { Route } from "@Library/Link.ts";

const Page: Frame = {
	Eyebrow: Content.Page.Activity.Eyebrow,
	Title: Content.Page.Activity.Title,
	Lede: Content.Page.Activity.Lede,
	Rail: Content.Showcase.Rail,
	Boxes: [
		{ Key: "Record", ...Content.Page.Activity.Section.Record },
		{ Key: "Subject", ...Content.Page.Activity.Section.Subject },
		{ Key: "Replay", ...Content.Page.Activity.Section.Replay },
	],
	Close: Content.Showcase.Close,
};
---

<Base Title={Content.Page.Activity.Title} Description={Content.Page.Activity.Description} Wide>
	<Board Page={Page} Href={Route.Workspace} />
</Base>
