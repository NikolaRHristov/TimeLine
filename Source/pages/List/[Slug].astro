---
/**
 * One list, drawn as a canvas.
 *
 * This page used to be the rows `/Bookmark` groups by list, filtered to a single
 * slug. The rows said what the archive contains; they did not say what a list
 * *is* in this design - a filter over the published canvas. So the list is now
 * the canvas itself: the same seat table the homepage and `/Bookmark` draw, fed
 * with one list's posts, so a list looks like a home that has been filtered
 * rather than like a second kind of page.
 *
 * Placement is data. A record takes the seat its position in the order gives it
 * (`Bento.Seats`), never a position the page invents - the page decides which
 * records go on the canvas, the canvas decides where. The order is newest first,
 * so the hero seat is the most recent post filed under the slug.
 *
 * The mosaic is ten seats. A list longer than that repeats the composition as
 * another band rather than inventing a second layout: each band completes itself
 * with its own empty seats, so a band holding two records still reads as a
 * composed page. That is the same rule `/Bookmark` follows, and it is why a thin
 * list is a normal state here instead of a broken grid.
 *
 * The slug is a route parameter, so the path is `/List/<slug>` - one segment,
 * never nested. A slug comes from the person's configuration and is not trusted
 * to be URL-safe: `Canonical()` percent-encodes it when it builds the link, and
 * Astro encodes it again when it builds the path, so the two agree. A slug with
 * no published post has no page at all: `getStaticPaths` derives the set from the
 * posts, so the route cannot exist for a name that resolves to nothing.
 */
import Bento, { Seats, type Tile } from "@Component/Workspace/Bento.tsx";
import Base from "@Layout/Base.astro";
import { Content } from "@Library/Content.ts";
import { BookmarkHref, Route } from "@Library/Link.ts";
import { fill } from "@Library/Text.ts";
import "@Stylesheet/Component/Note.scss";
import { getCollection } from "astro:content";

/** The bucket a post lands in when no list has claimed it. */
const Unsorted = Content.Word.Unsorted;

export async function getStaticPaths() {
	const bookmarks = await getCollection("Bookmark");
	const slugs = new Set<string>();

	for (const entry of bookmarks) {
		if (entry.data.lists.length === 0) {
			slugs.add(Unsorted);
		}

		for (const list of entry.data.lists) {
			slugs.add(list);
		}
	}

	return [...slugs].map((Slug) => ({ params: { Slug }, props: { Slug } }));
}

const { Slug } = Astro.props;

const bookmarks = await getCollection("Bookmark");

const entries = bookmarks
	.filter((entry) => (entry.data.lists.length > 0 ? entry.data.lists : [Unsorted]).includes(Slug))
	.sort((left, right) =>
		(right.data.postedAt ?? right.data.firstSeenAt).localeCompare(
			left.data.postedAt ?? left.data.firstSeenAt,
		),
	);

const description = fill(Content.Page.List.Detail.Description, {
	count: String(entries.length),
	saved: Content.Word.Saved,
	postNoun: Content.Word.Posts,
	slug: Slug,
});
const lede = fill(Content.Page.List.Detail.Lede, {
	count: String(entries.length),
	saved: Content.Word.Saved,
	postNoun: entries.length === 1 ? Content.Word.Post : Content.Word.Posts,
});
const day = (value: string): string => value.slice(0, 10);

/** One line of a post, short enough to sit in a tile. */
const Line = (Text: string, Length = 64): string => {
	const Flat = Text.replace(/\s+/g, " ").trim();

	return Flat.length > Length ? `${Flat.slice(0, Length - 1)}…` : Flat;
};

/**
 * One tile: the seat its position in the band gives it, and what the record says
 * in it. The eyebrow is the account, the meta line is the count and the day the
 * post was written - the two facts a reader uses to decide whether to open it.
 */
const Place = (entry: (typeof entries)[number], Index: number): Tile => ({
	...Seats[Index],
	Id: entry.id,
	Eyebrow: `@${entry.data.author.handle}`,
	Title: Line(entry.data.text),
	Meta: `${entry.data.metrics.likes} ${Content.Page.Bookmark.Detail.Metric.Likes} · ${day(
		entry.data.postedAt ?? entry.data.firstSeenAt,
	)}`,
	Href: BookmarkHref(entry.id),
});

/**
 * The bands the canvas is drawn in.
 *
 * A band is one full pass of the seat table. Slicing before mapping is what
 * makes the seat index a rank within the band, so the second band opens with a
 * hero again instead of running off the end of the table.
 */
const Bands = Array.from({ length: Math.ceil(entries.length / Seats.length) }, (_, Band) =>
	entries.slice(Band * Seats.length, (Band + 1) * Seats.length).map(Place),
);
---

<Base Title={Slug} Description={description} Wide>
	<article>
		<header class="page sheet__head">
			<h1 class="sheet__title">{Slug}</h1>
			<p class="sheet__lede">{lede}</p>
		</header>

		{Bands.map((Tiles) => (
			<Bento Tiles={Tiles} />
		))}

		{entries.length === 0 && (
			<div class="page">
				<section class="note">
					<h2 class="note__title">{Content.Empty.List}</h2>
					<p class="note__body">{Content.Page.List.Detail.EmptyBody}</p>
				</section>
			</div>
		)}

		<footer class="page sheet__foot">
			<a href={Route.List}>{Content.Page.List.Detail.AllLists}</a>
			<span>·</span>
			<a href={Route.Bookmark}>{Content.Route.Bookmarks}</a>
		</footer>
	</article>
</Base>
