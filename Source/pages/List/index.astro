---
/**
 * The lists index: one entry per slug the published posts carry.
 *
 * The set is derived from the posts, never from a fixed list of names - the
 * person who configured the archive decides what its lists are called, and this
 * page reads that decision back out of the published content. A clone with one
 * synthetic post therefore shows one list, and a clone with none shows the
 * empty state rather than a directory of links that go nowhere.
 *
 * `Unsorted` is the bucket for a post no list has claimed yet. It is listed
 * like any other list because it is one: a visitor looking for something they
 * know they saved should be able to find the posts the pipeline has not filed.
 */
import Base from "@Layout/Base.astro";
import { ListHref, Route } from "@Library/Link.ts";
import "@Stylesheet/Component/Note.css";
import "@Stylesheet/Component/Roster.css";
import { getCollection } from "astro:content";

/** The bucket a post lands in when no list has claimed it. */
const Unsorted = "Unsorted";

const bookmarks = await getCollection("Bookmark");

const counted = new Map<string, number>();

for (const entry of bookmarks) {
	const lists = entry.data.lists.length > 0 ? entry.data.lists : [Unsorted];

	for (const list of lists) {
		counted.set(list, (counted.get(list) ?? 0) + 1);
	}
}

/** Alphabetical, with `Unsorted` last: it is the remainder, not a name. */
const lists = [...counted].sort(([left], [right]) => {
	if (left === Unsorted) return 1;
	if (right === Unsorted) return -1;
	return left.localeCompare(right);
});

const total = bookmarks.length;
---

<Base Title="Lists" Description={`${lists.length} lists across ${total} saved posts.`}>
	<article class="sheet">
		<header class="sheet__head">
			<h1 class="sheet__title">Lists</h1>
			<p class="sheet__lede">
				{lists.length} {lists.length === 1 ? "list" : "lists"} across {total} saved
				{total === 1 ? " post" : " posts"}.
			</p>
		</header>

		{lists.length > 0 && (
			<ul class="roster">
				{lists.map(([list, count]) => (
					<li class="roster__row">
						<a class="roster__label" href={ListHref(list)}>
							{list}
						</a>
						<span class="roster__meta">
							{count} {count === 1 ? "post" : "posts"}
						</span>
					</li>
				))}
			</ul>
		)}

		{lists.length === 0 && (
			<section class="note">
				<h2 class="note__title">No lists yet</h2>
				<p class="note__body">
					A list exists once a published post carries its slug. Scrape and publish a post
					that has one, or leave it - the archive reads the same either way.
				</p>
				<ol>
					<li>
						<code>maintain store scrape --source bookmark</code>
					</li>
					<li>
						<code>maintain store publish --all</code>
					</li>
				</ol>
			</section>
		)}

		<footer class="sheet__foot">
			<a href={Route.Bookmark}>Bookmarks</a>
			<span>·</span>
			<a href={Route.Voted}>Voted</a>
			<span>·</span>
			<a href={Route.Activity}>Activity</a>
		</footer>
	</article>
</Base>
