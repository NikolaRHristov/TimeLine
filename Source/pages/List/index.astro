---
/**
 * Lists: the rule behind the names, not the names themselves.
 *
 * The index used to be one column per list slug, derived from the published
 * posts, each column previewing its newest four. It was an honest view of an
 * archive and a poor first page: on a clone with one post it showed one column,
 * and on a clone with none it showed a note explaining the absence.
 *
 * RFC-0053 makes it a showcase page (rule 1): no collection is read, so the page
 * states what a list is - a name the owner gives a set of records - and the rail
 * becomes a table of contents. A name that no published record carries has no
 * page, which is the rule the sections say in words rather than the empty grid
 * that used to say it by accident.
 *
 * `/List/<slug>` still renders one list's canvas; it is a data surface and reads
 * the archive it filters.
 */
import Board, { type Frame } from "@Component/Showcase/Board.astro";
import Base from "@Layout/Base.astro";
import { Content } from "@Library/Content.ts";
import { Route } from "@Library/Link.ts";

const Page: Frame = {
	Eyebrow: Content.Page.List.Eyebrow,
	Title: Content.Page.List.Title,
	Lede: Content.Page.List.Lede,
	Rail: Content.Showcase.Rail,
	Boxes: [
		{ Key: "Name", ...Content.Page.List.Section.Name },
		{ Key: "Filter", ...Content.Page.List.Section.Filter },
		{ Key: "Slug", ...Content.Page.List.Section.Slug },
	],
	Close: Content.Showcase.Close,
};
---

<Base Title={Content.Page.List.Title} Description={Content.Page.List.Description} Wide>
	<Board Page={Page} Href={Route.Workspace} />
</Base>
