---
/**
 * The lists index: one entry per slug the published posts carry.
 *
 * The set is derived from the posts, never from a fixed list of names - the
 * person who configured the archive decides what its lists are called, and this
 * page reads that decision back out of the published content. A clone with one
 * synthetic post therefore shows one list, and a clone with none shows the
 * empty state rather than a directory of links that go nowhere.
 *
 * The unsorted bucket is for a post no list has claimed yet. It is listed like
 * any other list because it is one: a visitor looking for something they know
 * they saved should be able to find the posts the pipeline has not filed.
 */
import Base from "@Layout/Base.astro";
import { Content } from "@Library/Content.ts";
import { ListHref, Route } from "@Library/Link.ts";
import { fill } from "@Library/Text.ts";
import "@Stylesheet/Component/Note.css";
import "@Stylesheet/Component/Roster.css";
import { getCollection } from "astro:content";

/** The bucket a post lands in when no list has claimed it. */
const Unsorted = Content.Word.Unsorted;

const bookmarks = await getCollection("Bookmark");

const counted = new Map<string, number>();

for (const entry of bookmarks) {
	const lists = entry.data.lists.length > 0 ? entry.data.lists : [Unsorted];

	for (const list of lists) {
		counted.set(list, (counted.get(list) ?? 0) + 1);
	}
}

/** Alphabetical, with the unsorted bucket last: it is the remainder, not a name. */
const lists = [...counted].sort(([left], [right]) => {
	if (left === Unsorted) return 1;
	if (right === Unsorted) return -1;
	return left.localeCompare(right);
});

const total = bookmarks.length;
const description = fill(Content.Page.List.Description, {
	listCount: String(lists.length),
	listNoun: Content.Word.Lists,
	across: Content.Word.Across,
	total: String(total),
	saved: Content.Word.Saved,
	postNoun: Content.Word.Posts,
});
const lede = fill(Content.Page.List.Lede, {
	listCount: String(lists.length),
	listNoun: lists.length === 1 ? Content.Word.List : Content.Word.Lists,
	across: Content.Word.Across,
	total: String(total),
	saved: Content.Word.Saved,
	postNoun: total === 1 ? Content.Word.Post : Content.Word.Posts,
});
---

<Base Title={Content.Route.Lists} Description={description}>
	<article class="sheet">
		<header class="sheet__head">
			<h1 class="sheet__title">{Content.Route.Lists}</h1>
			<p class="sheet__lede">{lede}</p>
		</header>

		{lists.length > 0 && (
			<ul class="roster">
				{lists.map(([list, count]) => (
					<li class="roster__row">
						<a class="roster__label" href={ListHref(list)}>
							{list}
						</a>
						<span class="roster__meta">
							{count} {count === 1 ? Content.Word.Post : Content.Word.Posts}
						</span>
					</li>
				))}
			</ul>
		)}

		{lists.length === 0 && (
			<section class="note">
				<h2 class="note__title">{Content.Empty.Lists}</h2>
				<p class="note__body">{Content.Page.List.EmptyBody}</p>
				<ol>
					<li>
						<code>{Content.Example.Scrape}</code>
					</li>
					<li>
						<code>{Content.Example.Publish}</code>
					</li>
				</ol>
			</section>
		)}

		<footer class="sheet__foot">
			<a href={Route.Bookmark}>{Content.Route.Bookmarks}</a>
			<span>·</span>
			<a href={Route.Voted}>{Content.Route.Voted}</a>
			<span>·</span>
			<a href={Route.Activity}>{Content.Route.Activity}</a>
		</footer>
	</article>
</Base>
