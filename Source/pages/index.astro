---
/**
 * The front page: the system stated, not the archive counted.
 *
 * This route used to be the Curated index drawn on the canvas - the owner's
 * picks in rank order, filled out with the newest bookmarks. It read four
 * collections to do it, which made the page a dashboard over somebody's private
 * archive: thin on a fresh clone, stale behind a cache, and never a
 * demonstration of what the system is.
 *
 * RFC-0053 turns it around. A page that is not the workspace is a showcase, and
 * a showcase page reads nothing (rule 1): it is copy and composition, so it is
 * `ready` by construction, it renders the same on a fresh clone as on a full
 * archive, and no count on it can be wrong.
 *
 * The data did not disappear - it moved. `/Workspace` is public (RFC-0054) and
 * is where a person's own records live; this page says what that surface is
 * made of, in three sections, and the closing band is the way in.
 *
 * The rail is the workspace's own drum, mounted rather than copied, repurposed
 * as a table of contents (rule 3): one band per section, each a link to its own
 * anchor.
 */
import Board, { type Frame } from "@Component/Showcase/Board.astro";
import Base from "@Layout/Base.astro";
import { Content } from "@Library/Content.ts";
import { Route } from "@Library/Link.ts";

/**
 * The page, in the content layer's words.
 *
 * Every string resolves through `@Library/Content.ts`, which is baked from
 * `Content/**` at build time, so no sentence is written in a component and the
 * page has nothing to read at run time.
 */
const Page: Frame = {
	Eyebrow: Content.Page.Index.Eyebrow,
	Title: Content.Page.Index.Title,
	Lede: Content.Page.Index.Lede,
	Rail: Content.Showcase.Rail,
	Boxes: [
		{ Key: "Source", ...Content.Page.Index.Section.Source },
		{ Key: "Processing", ...Content.Page.Index.Section.Processing },
		{ Key: "Review", ...Content.Page.Index.Section.Review },
	],
	Close: Content.Showcase.Close,
};
---

<Base Description={Content.Page.Index.Description} Wide>
	<Board Page={Page} Href={Route.Workspace} />
</Base>
