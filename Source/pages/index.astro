---
/**
 * The front page: what this archive holds, in one screen.
 *
 * Everything here is a build-time read of the content collections, so the page
 * works the same whether the archive holds one synthetic post or ten thousand
 * scraped ones. An empty archive is a normal state, not an error - it renders
 * the commands that fill it instead of throwing.
 *
 * Every internal URL comes from `@Library/Link.ts`, which derives it from the
 * route map: the list pills point at `/List/<slug>` rather than at the bookmark
 * index, because a list has its own page now and a link that hid that would be
 * the one place the map is not the source of truth.
 */
import Base from "@Layout/Base.astro";
import { BookmarkHref, ListHref, Route } from "@Library/Link.ts";
import "@Stylesheet/Component/Note.css";
import "@Stylesheet/Component/Pill.css";
import "@Stylesheet/Component/Roster.css";
import { getCollection } from "astro:content";

const bookmarks = await getCollection("Bookmark");
const events = await getCollection("Event");
const curated = await getCollection("Curated");
const voted = await getCollection("Voted");

/**
 * The Curated index: the owner's picks, in the owner's order.
 *
 * Joined by id, never copied: `Curated/<id>.json` carries the rank and the
 * vote count frozen at approval time, and the payload comes from the bookmark
 * - or from the Voted entry when the post was curated without being published
 * as a bookmark. An entry whose payload has vanished is dropped rather than
 * rendered as a dead link.
 */
const ranked = [...curated]
	.sort((left, right) => left.data.rank - right.data.rank || left.id.localeCompare(right.id))
	.map((entry) => ({
		rank: entry.data.rank,
		votes: entry.data.votes,
		id: entry.id,
		bookmark: bookmarks.find((bookmark) => bookmark.id === entry.id) ?? null,
		voted: voted.find((candidate) => candidate.id === entry.id) ?? null,
	}))
	.filter((entry) => entry.bookmark !== null || entry.voted !== null);

const newest = [...bookmarks]
	.sort((left, right) =>
		(right.data.postedAt ?? right.data.firstSeenAt).localeCompare(
			left.data.postedAt ?? left.data.firstSeenAt,
		),
	)
	.slice(0, 5);

/** The slugs this archive actually uses - the person's lists, not a fixed set. */
const lists = [...new Set(bookmarks.flatMap((entry) => entry.data.lists))].sort();

const total = bookmarks.length;

/**
 * One sentence for the header.
 *
 * Assembled as a string rather than as interleaved JSX expressions: the
 * optional `across N lists` clause used to sit between two text nodes, which
 * left the sentence reading `0 saved posts , 0 events recorded.` - a stray
 * space before the comma, visible exactly in the empty state this page is
 * supposed to make look deliberate.
 */
const summary = `${total} saved ${total === 1 ? "post" : "posts"}${
	lists.length > 0 ? ` across ${lists.length} ${lists.length === 1 ? "list" : "lists"}` : ""
}, ${events.length} ${events.length === 1 ? "event" : "events"} recorded.`;

const excerpt = (text: string): string =>
	text.length > 160 ? `${text.slice(0, 160).trimEnd()}…` : text;
const day = (value: string): string => value.slice(0, 10);
---

<Base Description={`${total} saved posts, ${lists.length} lists, curated by hand.`}>
	<article class="sheet">
		<header class="sheet__head">
			<h1 class="sheet__title">Curated</h1>
			<p class="sheet__lede">{summary}</p>
		</header>

		{total === 0 && (
			<section class="note">
				<h2 class="note__title">No bookmarks yet</h2>
				<p class="note__body">
					Nothing has been published into this archive. Scrape your own bookmarks into the
					shadow store, then publish what you want to show:
				</p>
				<ol>
					<li>
						<code>maintain store scrape --source bookmark</code>
					</li>
					<li>
						<code>maintain store publish --all</code>
					</li>
					<li>
						<code>pnpm run build</code>
					</li>
				</ol>
				<p class="note__body">
					The commands need a browser exposing the DevTools Protocol and a configured
					identifier map - see
					<code>Documentation/Reference/Configure.md</code>.
				</p>
			</section>
		)}

		{ranked.length > 0 && (
			<section class="sheet__section">
				<h2 class="sheet__heading">Picks</h2>
				<ol class="roster">
					{ranked.map((entry) => (
						<li class="roster__row">
							<span class="roster__lead">{entry.rank}</span>
							{entry.bookmark !== null ? (
								<a class="roster__label" href={BookmarkHref(entry.id)}>
									{excerpt(entry.bookmark.data.text)}
								</a>
							) : (
								<a
									class="roster__label"
									href={entry.voted?.data.url}
									rel="noopener noreferrer">
									{entry.voted?.data.title ?? entry.voted?.data.url}
								</a>
							)}
							<span class="roster__meta">
								{entry.votes} {entry.votes === 1 ? "vote" : "votes"}
							</span>
						</li>
					))}
				</ol>
			</section>
		)}

		{lists.length > 0 && (
			<ul class="pill__row">
				{lists.map((list) => (
					<li>
						<a class="pill__link" href={ListHref(list)}>
							{list}
						</a>
					</li>
				))}
			</ul>
		)}

		{newest.length > 0 && (
			<section>
				<h2 class="sheet__heading">Latest</h2>
				<ul class="roster">
					{newest.map((entry) => (
						<li class="roster__row">
							<a class="roster__label" href={BookmarkHref(entry.id)}>
								{excerpt(entry.data.text)}
							</a>
							<span class="roster__meta">
								@{entry.data.author.handle} ·{" "}
								{day(entry.data.postedAt ?? entry.data.firstSeenAt)}
							</span>
						</li>
					))}
				</ul>
				<p class="mt-4 text-sm">
					<a class="underline" href={Route.Bookmark}>
						All bookmarks →
					</a>
				</p>
			</section>
		)}

		<footer class="sheet__foot">
			<a href={Route.Bookmark}>Bookmarks</a>
			<span>·</span>
			<a href={Route.List}>Lists</a>
			<span>·</span>
			<a href={Route.Voted}>Voted</a>
			<span>·</span>
			<a href={Route.Activity}>Activity</a>
		</footer>
	</article>
</Base>
