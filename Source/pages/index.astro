---
/**
 * The front page: what this archive holds, in one screen.
 *
 * Everything here is a build-time read of the content collections, so the page
 * works the same whether the archive holds one synthetic post or ten thousand
 * scraped ones. An empty archive is a normal state, not an error - it renders
 * the commands that fill it instead of throwing.
 */
import Base from "@Layout/Base.astro";
import { getCollection } from "astro:content";

const bookmarks = await getCollection("Bookmark");
const events = await getCollection("Event");

const newest = [...bookmarks]
	.sort((left, right) =>
		(right.data.postedAt ?? right.data.firstSeenAt).localeCompare(
			left.data.postedAt ?? left.data.firstSeenAt,
		),
	)
	.slice(0, 5);

/** The slugs this archive actually uses - the person's lists, not a fixed set. */
const lists = [
	...new Set(bookmarks.flatMap((entry) => entry.data.lists)),
].sort();

const total = bookmarks.length;
const excerpt = (text: string): string =>
	text.length > 160 ? `${text.slice(0, 160).trimEnd()}…` : text;
const day = (value: string): string => value.slice(0, 10);
---

<Base
	Title="Bookmarks"
	Description={`${total} saved posts, grouped by list and author.`}>
	<main class="container mx-auto max-w-3xl px-6 py-10">
		<header class="mb-10">
			<h1 class="text-2xl font-semibold">Bookmarks</h1>
			<p class="mt-1 text-sm text-neutral-600">
				{total}
				saved {total === 1 ? "post" : "posts"}
				{lists.length > 0 && (
					<span>
						across {lists.length}{" "}
						{lists.length === 1 ? "list" : "lists"}
					</span>
				)}
				, {events.length}
				{events.length === 1 ? "event" : "events"} recorded.
			</p>
		</header>

		{total === 0 && (
			<section class="rounded border border-neutral-200 p-6 text-sm text-neutral-700">
				<h2 class="mb-2 text-base font-semibold">No bookmarks yet</h2>
				<p class="mb-3">
					Nothing has been published into this archive. Scrape your
					own bookmarks into the shadow store, then publish what you
					want to show:
				</p>
				<ol class="space-y-1">
					<li>
						<code class="rounded bg-neutral-100 px-1">
							maintain store scrape --source bookmark
						</code>
					</li>
					<li>
						<code class="rounded bg-neutral-100 px-1">
							maintain store publish --all
						</code>
					</li>
					<li>
						<code class="rounded bg-neutral-100 px-1">
							pnpm run build
						</code>
					</li>
				</ol>
				<p class="mt-3">
					The commands need a browser exposing the DevTools Protocol
					and a configured identifier map - see
					<code class="mx-1 rounded bg-neutral-100 px-1">
						Documentation/Reference/Configure.md
					</code>
					.
				</p>
			</section>
		)}

		{lists.length > 0 && (
			<nav class="mb-8 flex flex-wrap gap-2 text-xs">
				{lists.map((list) => (
					<a
						class="rounded-full border border-neutral-200 px-3 py-1 text-neutral-700 hover:border-neutral-400"
						href="/Bookmark/">
						{list}
					</a>
				))}
			</nav>
		)}

		{newest.length > 0 && (
			<section>
				<h2 class="mb-3 border-b border-neutral-200 pb-2 text-lg font-semibold">
					Latest
				</h2>
				<ul class="space-y-3">
					{newest.map((entry) => (
						<li class="leading-snug">
							<a
								class="underline decoration-neutral-300 underline-offset-2 hover:decoration-neutral-900"
								href={`/Bookmark/${entry.id}/`}>
								{excerpt(entry.data.text)}
							</a>
							<span class="ml-2 whitespace-nowrap text-xs text-neutral-500">
								@{entry.data.author.handle} ·{" "}
								{day(
									entry.data.postedAt ??
										entry.data.firstSeenAt,
								)}
							</span>
						</li>
					))}
				</ul>
				<p class="mt-4 text-sm">
					<a class="underline" href="/Bookmark/">
						All bookmarks →
					</a>
				</p>
			</section>
		)}

		<footer class="mt-12 border-t border-neutral-200 pt-4 text-xs text-neutral-500">
			<a class="underline" href="/Bookmark/">
				Bookmarks
			</a>
			<span class="mx-2">·</span>
			<a class="underline" href="/Activity/">
				Activity
			</a>
		</footer>
	</main>
</Base>
