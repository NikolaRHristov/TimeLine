---
/**
 * The Voted index: what people are being asked to rank.
 *
 * A candidate is public here and nowhere else. Approving one is a command the
 * owner runs, and the Curated index on the homepage is the only place an
 * approved entry appears - so this page can be as open as it likes without
 * publishing anything.
 *
 * Two builds of this page exist, and both are normal:
 *
 * - **No vote configuration** (every fresh clone). The counts on file are
 *   shown, the line under the heading says voting is not configured, and there
 *   are no buttons. No request, no error, no empty page.
 * - **A configured project.** The same rows, plus a `Vote` control per row and
 *   the live counts fetched by `Source/Script/Vote/Widget.ts`.
 *
 * Nothing is fetched while this page is built: the numbers come from the
 * content collection, which `maintain vote sync` refreshed last time the owner
 * ran it.
 *
 * The `data-vote-*` attributes are the widget's contract. They are on the same
 * elements as the roster classes on purpose: the markup is styled by the
 * stylesheet and found by the script, and neither has to know about the other.
 */
import "@Stylesheet/Component/Note.scss";
import "@Stylesheet/Component/Roster.scss";
import Base from "@Layout/Base.astro";
import { Content } from "@Library/Content.ts";
import { Route } from "@Library/Link.ts";
import { fill } from "@Library/Text.ts";
import { read as readConfiguration } from "@Script/Vote/Configuration.ts";
import { getCollection } from "astro:content";

const voted = await getCollection("Voted");
const configuration = readConfiguration();
const configured = configuration !== null;

/**
 * Candidates only, best-supported first, ties broken by the older nomination
 * and then by id so the order never depends on the filesystem.
 *
 * Approved entries are not repeated here - they are on the homepage - and a
 * rejected entry is a tombstone, so it is not rendered at all.
 */
const candidates = voted
	.filter((entry) => entry.data.status === "candidate")
	.sort(
		(left, right) =>
			right.data.votes - left.data.votes ||
			left.data.nominatedAt.localeCompare(right.data.nominatedAt) ||
			left.id.localeCompare(right.id),
	);

const description = fill(Content.Page.Voted.Description, { count: String(candidates.length) });
const lede = fill(Content.Page.Voted.Lede, {
	count: String(candidates.length),
	candidateNoun: candidates.length === 1 ? Content.Word.Candidate : Content.Word.Candidates,
});
const day = (value: string): string => value.slice(0, 10);
const label = (entry: (typeof candidates)[number]): string =>
	entry.data.title !== undefined && entry.data.title !== "" ? entry.data.title : entry.data.url;
---

<Base Title={Content.Route.Voted} Description={description}>
	<article class="sheet">
		<header class="sheet__head">
			<h1 class="sheet__title">{Content.Route.Voted}</h1>
			<p class="sheet__lede">{lede}</p>
			{!configured && (
				<p class="sheet__lede">
					{Content.Page.Voted.NotConfiguredBefore}
					<code>{Content.Reference.Voting}</code>
					{Content.Page.Voted.NotConfiguredAfter}
				</p>
			)}
		</header>

		{candidates.length === 0 && (
			<section class="note">
				<h2 class="note__title">{Content.Empty.Voted}</h2>
				<p class="note__body">{Content.Page.Voted.EmptyBody}</p>
				<ol>
					<li>
						<code>{Content.Example.Nominate}</code>
					</li>
					<li>
						<code>{Content.Example.Queue}</code>
					</li>
					<li>
						<code>{Content.Example.Approve}</code>
					</li>
				</ol>
				<p class="note__body">
					{Content.Page.Voted.EmptyHintBefore}
					<code>{Content.Reference.Voting}</code>
					{Content.Page.Voted.EmptyHintAfter}
				</p>
			</section>
		)}

		{candidates.length > 0 && (
			<div data-vote>
				<ol class="roster">
					{candidates.map((entry) => (
						<li class="roster__row" data-vote-row>
							<span class="roster__lead" data-vote-total>
								{entry.data.votes}
							</span>
							<a
								class="roster__label"
								href={entry.data.url}
								rel="noopener noreferrer">
								{label(entry)}
							</a>
							<span class="roster__meta">
								{entry.data.author.handle === ""
									? Content.Page.Voted.UnknownAuthor
									: `@${entry.data.author.handle}`}
								{" · "}
								{fill(Content.Page.Voted.Nominated, {
									day: day(entry.data.nominatedAt),
								})}
								{entry.data.lists.length > 0 && ` · ${entry.data.lists.join(", ")}`}
							</span>
							{entry.data.note !== undefined && entry.data.note !== "" && (
								<span class="roster__aside">{entry.data.note}</span>
							)}
							{configured && (
								<button
									class="ml-auto rounded border border-neutral-300 px-3 py-1 text-xs text-neutral-700 hover:border-neutral-500 disabled:opacity-50"
									data-vote-id={entry.data.id}
									type="button">
									{Content.Page.Voted.Button}
								</button>
							)}
						</li>
					))}
				</ol>
				{configured && <p class="mt-4 text-xs text-neutral-600" data-vote-status hidden />}
			</div>
		)}

		<footer class="sheet__foot">
			<a href={Route.Home}>{Content.Route.Curated}</a>
			<span>·</span>
			<a href={Route.Bookmark}>{Content.Route.Bookmarks}</a>
			<span>·</span>
			<a href={Route.List}>{Content.Route.Lists}</a>
			<span>·</span>
			<a href={Route.Activity}>{Content.Route.Activity}</a>
		</footer>
	</article>
</Base>

{configuration !== null && (
	<script
		type="application/json"
		id="Vote-Configuration"
		set:html={JSON.stringify(configuration)}
	/>
)}

<script>
	import "@Script/Vote/Widget";
</script>
