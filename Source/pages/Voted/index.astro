---
/**
 * Voted: the queue, explained rather than shown.
 *
 * The page used to render the candidate roster with its counts, its authors and
 * a `Vote` control per row when a vote store was configured. Everything about
 * that page depended on a collection, and on a clone with no vote store it was
 * an empty state with three commands in it.
 *
 * RFC-0053 makes it a showcase page: no collection is read, no count is shown,
 * no roster is drawn. The three sections state what a candidate is, what a vote
 * does and what settling one means, which is the part a reader needs before any
 * queue is worth looking at. The rail is the workspace's drum reused as a table
 * of contents.
 *
 * Nothing is lost by the change: a candidate is public in the archive, and the
 * owner's own queue is drawn in the workspace's drawer (RFC-0054).
 */
import Board, { type Frame } from "@Component/Showcase/Board.astro";
import Base from "@Layout/Base.astro";
import { Content } from "@Library/Content.ts";
import { Route } from "@Library/Link.ts";

const Page: Frame = {
	Eyebrow: Content.Page.Voted.Eyebrow,
	Title: Content.Page.Voted.Title,
	Lede: Content.Page.Voted.Lede,
	Rail: Content.Showcase.Rail,
	Boxes: [
		{ Key: "Nominate", ...Content.Page.Voted.Section.Nominate },
		{ Key: "Rank", ...Content.Page.Voted.Section.Rank },
		{ Key: "Settle", ...Content.Page.Voted.Section.Settle },
	],
	Close: Content.Showcase.Close,
};
---

<Base Title={Content.Page.Voted.Title} Description={Content.Page.Voted.Description} Wide>
	<Board Page={Page} Href={Route.Workspace} />
</Base>
