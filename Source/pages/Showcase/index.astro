---
/**
 * The showcase spread - the layout primitive for RFC-0053, demonstrated.
 *
 * Six boxes, dispersed down a centred column: the provenance rail, the drawer, the
 * publish seam, the canvas, the network, and a motion. Each states one claim and
 * leads to the surface that proves it. The page closes on the three pillars of the
 * swimlane flow (RFC-0047), so the last thing read is the mechanism rather than a
 * slogan.
 *
 * The copy lives in `Content/String/Page/Showcase/` and resolves through
 * `@Library/Content.ts` like every other string: the masthead, the six cards and
 * the three pillars. Every card body and pillar note names the protocol or the
 * record it rests on, and `Scripts/Position.mjs` fails the build when one does
 * not (RFC-0055 rule 4).
 *
 * No collection is read and no island is mounted: the page is `ready` by
 * construction, renders identically on an empty archive, and cannot fail without
 * JavaScript because it ships none.
 */
import Spread, { type Card, type Pillar } from "@Component/Showcase/Spread.astro";
import Base from "@Layout/Base.astro";
import { Content } from "@Library/Content.ts";

/** The spread's own words, all of them from `Content/` (RFC-0053 rule 4). */
const Showcase = Content.Page.Showcase;

const Cards: Card[] = [
	{
		Eyebrow: "Provenance",
		Title: Showcase.Card.Provenance.Title,
		Body: Showcase.Card.Provenance.Body,
		Href: "/Workspace",
		Tone: "loud",
	},
	{
		Eyebrow: "Drawer",
		Title: Showcase.Card.Drawer.Title,
		Body: Showcase.Card.Drawer.Body,
		Href: "/Workspace",
	},
	{
		Eyebrow: "Seam",
		Title: Showcase.Card.Seam.Title,
		Body: Showcase.Card.Seam.Body,
		Href: "/Workspace",
		Tone: "quiet",
	},
	{
		Eyebrow: "Canvas",
		Title: Showcase.Card.Canvas.Title,
		Body: Showcase.Card.Canvas.Body,
		Href: "/Workspace",
	},
	{
		Eyebrow: "Network",
		Title: Showcase.Card.Network.Title,
		Body: Showcase.Card.Network.Body,
	},
	{
		Eyebrow: "Motion",
		Title: Showcase.Card.Motion.Title,
		Body: Showcase.Card.Motion.Body,
		Tone: "loud",
	},
];

const Pillars: Pillar[] = [
	{
		Name: Showcase.Pillar.Authenticated.Name,
		Note: Showcase.Pillar.Authenticated.Note,
	},
	{
		Name: Showcase.Pillar.Encrypted.Name,
		Note: Showcase.Pillar.Encrypted.Note,
	},
	{
		Name: Showcase.Pillar.Authorised.Name,
		Note: Showcase.Pillar.Authorised.Note,
	},
];
---

<Base Title={Content.Brand.Title} Description={Content.Brand.Description} Wide>
	<Spread
		Eyebrow={Showcase.Eyebrow}
		Title={Showcase.Title}
		Lede={Showcase.Lede}
		Cards={Cards}
		Pillars={Pillars}
	/>
</Base>
