---
/**
 * The workspace: the composition every reader gets, with no gate in front of it.
 *
 * `/Workspace` is public (RFC-0054). An unauthenticated reader loads the whole
 * composition - the rail, the drawer, the seam and the canvas - and is never
 * sent to a sign-in: a page that gates the product's own demonstration cannot be
 * seen without joining it, which is the opposite of what a network provider
 * should ask.
 *
 * The build emits the anonymous workspace. The drawer's four lanes are drawn
 * with no records in them, and the canvas draws its seats with nothing placed
 * on them. That is the honest page rather than a degraded one: the drawer is the
 * reader's own, so a row in it would be a row they own, and a drawer filled with
 * samples is the one place this product would lie about whose data is on screen
 * (RFC-0054 §2). The note over the lanes says what the shape is waiting for and
 * names the command that fills it (RFC-0050 rule 1); hydration replaces the page
 * only with state it can name (RFC-0043).
 *
 * Publishing is `locked` rather than absent (RFC-0049, RFC-0054 §3). The seam
 * keeps its destination control, carries `aria-disabled` and states the reason
 * in its note: a published record carries an author, so publishing needs an
 * identity (RFC-0013). The rail's counts are the archive's rather than the
 * drawer's, and the archive is public - `/` publishes the same records.
 *
 * Everything the page knows is read at build time and handed to the Solid
 * islands as plain data. That split is deliberate - the shell, the rail and the
 * canvas are static HTML a service worker can serve from cache, while the
 * workspace hydrates because what a person sees in their own drawer depends on
 * who they are and which network they belong to. The islands hydrate on
 * visibility rather than on load, so the composition paints from the build
 * before any bundle competes for the main thread. The rule that keeps it honest
 * - every route renders its content with scripts switched off - is audited by
 * `Documentation/Skill/Progressive-Enhancement`.
 *
 * An empty archive is a normal state here, not an error: every collection is
 * read with a default, so a fresh clone renders the composition with empty
 * columns instead of throwing. The page never reads the shadow store or the
 * database - the collections are the only source.
 */
import { type Tile } from "@Component/Workspace/Bento.tsx";
import Rail from "@Component/Workspace/Rail.tsx";
import Workspace from "@Component/Workspace/Workspace.tsx";
import Base from "@Layout/Base.astro";
import { Bands } from "@Library/Band.ts";
import { Content } from "@Library/Content.ts";
import { ColumnAccent, StageAccent } from "@Library/Stage.ts";
import { Own } from "@Script/Session/Context.ts";
import { getCollection } from "astro:content";

const bookmarks = await getCollection("Bookmark");
const voted = await getCollection("Voted");
const curated = await getCollection("Curated");
const events = await getCollection("Event");

/** `1 events` reads as a defect; every label on the rail is a sentence. */
const Count = (Value: number, Singular: string) =>
	`${Value} ${Value === 1 ? Singular : `${Singular}s`}`;

const Stages = [
	{
		Key: "source",
		Label: `Source · ${Count(bookmarks.length, "event")}`,
		Tone: StageAccent.source,
		Events: bookmarks.length,
		Caption: `${Count(bookmarks.length, "event")} · Source · Selected`,
	},
	{
		Key: "ingestion",
		Label: `Ingestion · ${Count(events.length, "event")}`,
		Tone: StageAccent.ingestion,
		Events: events.length,
	},
	{
		Key: "processing",
		Label: `Processing · ${Count(voted.length, "event")}`,
		Tone: StageAccent.processing,
		Events: voted.length,
	},
	{
		Key: "review",
		Label: `Review · ${Count(curated.length, "event")}`,
		Tone: StageAccent.review,
		Events: curated.length,
	},
];

/**
 * The drawer's four lanes, and nothing in them.
 *
 * The lanes are the composition's structure - what a reader's own records would
 * be filed into - so they are drawn whether or not they hold anything, and the
 * drawer's note sits over them rather than in place of them. The rows are empty
 * because the drawer belongs to the reader and this page is built before anybody
 * has identified themselves (RFC-0054 §2). A lane with no rows draws no drop
 * ghost either, so nothing here offers a verb the page cannot carry.
 */
const Columns = [
	{
		Key: "bookmark",
		Label: "Bookmarks",
		Tone: ColumnAccent("bookmark"),
		Ghost: "Drag to showcase ↓",
		Entries: [],
	},
	{
		Key: "voted",
		Label: "Voted",
		Tone: ColumnAccent("voted"),
		Ghost: "Drag to showcase ↓",
		Entries: [],
	},
	{
		Key: "curated",
		Label: "Curated",
		Tone: ColumnAccent("curated"),
		Ghost: "Drag to showcase ↓",
		Entries: [],
	},
	{
		Key: "author",
		Label: "Authors",
		Tone: ColumnAccent("author"),
		Ghost: "Drag to showcase ↓",
		Entries: [],
	},
];

/**
 * The canvas is empty for the same reason the drawer is.
 *
 * The build draws what a reader owns and, before a session exists, that is
 * nothing (RFC-0054 §1). The seats are still drawn - the canvas completes itself
 * from its own seat table - so an empty canvas is the full mosaic at its
 * quietest value rather than a hole in the composition.
 */
const Tiles: Tile[] = [];

/**
 * The contexts the rail may select.
 *
 * The build knows one: the owner's own archive, whose publish destination is the
 * public showcase. A room arrives with a session, and a session is read in the
 * browser - so a page that listed rooms here would be inventing them at build
 * time, which is the one thing the session layer must not do.
 */
const Title = "My Files";

const Contexts = [Own(Title, "Showcase · Network")];

/**
 * When the build's view is current to.
 *
 * The state line prints it, so a reader can tell the build's rows from a
 * snapshot's. Taken once, here, rather than in the island: the island's clock is
 * the reader's, and the build's rows are not current to the reader's clock.
 */
const Built = new Date().toISOString();

/**
 * The bands below the canvas, and the rail's security cluster.
 *
 * One value, derived once, handed to both islands: the rail prints the protocol
 * marks and the body prints the three bands, and the two must describe the same
 * network. `Bands()` states what the build can prove - two actors, no
 * relationship - so nothing here invents a peer or a state. Its footer reads
 * `static` for the connection and for the sync, which is what an anonymous
 * reader's status surfaces say: not `disconnected`, which would be alarming, and
 * not `connected`, which would be false (RFC-0054 §4).
 */
const Bands_ = Bands();
---

<Base Title="Workspace" Description={Content.Page.Workspace.Description} Wide Bare>
	<div class="workspace">
		<Rail
			client:visible
			Stages={Stages}
			Initial="source"
			Note="Scroll through source timelines · Source selected"
			Marks={Bands_.Marks}
			ClusterEyebrow={Bands_.Words.Cluster.Eyebrow}
			ClusterLabel={Bands_.Words.Cluster.Label}
		/>

		<Workspace
			client:visible
			Stages={Stages}
			Columns={Columns}
			Tiles={Tiles}
			Note="Scroll through source timelines · Source selected"
			Eyebrow="Depth / Schema"
			Title={Title}
			Hint={Content.Page.Workspace.Hint}
			Instruction="Drop private items here to publish"
			Locked={Content.Page.Workspace.LockReason}
			Remedy={Content.Example.Scrape}
			Empty={{
				Title: Content.Page.Workspace.EmptyTitle,
				Body: Content.Page.Workspace.EmptyBody,
				Hint: Content.Page.Workspace.EmptyHint,
				Reference: Content.Reference.Configure,
			}}
			Contexts={Contexts}
			AsOf={Built}
			Bands={Bands_}
		/>
	</div>
</Base>
