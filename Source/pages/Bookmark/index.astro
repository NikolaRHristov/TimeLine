---
/**
 * Bookmarks: what a saved post is, stated rather than listed.
 *
 * The route used to draw every published post on the canvas, band after band.
 * That was the archive read as a page, and on a fresh clone - which is what
 * anyone hosting their own starts with - it was an empty grid with an
 * explanation under it.
 *
 * RFC-0053 makes it a showcase page instead: no collection is read, no count is
 * shown, no tile is drawn. Three sections say what a bookmark is here - a capture, a private
 * record, a thing filed under a name - and the rail is the workspace's drum
 * reused as a table of contents.
 *
 * The record itself is still public: `/Bookmark/<id>` renders one post on the
 * workspace ground, and `/Workspace` is where a person's own records live
 * (RFC-0054). This page is the explanation, and it cannot be empty.
 */
import Board, { type Frame } from "@Component/Showcase/Board.astro";
import Base from "@Layout/Base.astro";
import { Content } from "@Library/Content.ts";
import { Route } from "@Library/Link.ts";

const Page: Frame = {
	Eyebrow: Content.Page.Bookmark.Eyebrow,
	Title: Content.Page.Bookmark.Title,
	Lede: Content.Page.Bookmark.Lede,
	Rail: Content.Showcase.Rail,
	Boxes: [
		{ Key: "Capture", ...Content.Page.Bookmark.Section.Capture },
		{ Key: "Private", ...Content.Page.Bookmark.Section.Private },
		{ Key: "Filed", ...Content.Page.Bookmark.Section.Filed },
	],
	Close: Content.Showcase.Close,
};
---

<Base Title={Content.Page.Bookmark.Title} Description={Content.Page.Bookmark.Description} Wide>
	<Board Page={Page} Href={Route.Workspace} />
</Base>
